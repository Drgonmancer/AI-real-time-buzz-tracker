# ===========================================
# Pulse Server - Environment Variables
# ===========================================

PORT=3000
NODE_ENV=development

# Database (SQLite for local dev)
DATABASE_URL="file:./dev.db"

# DeepSeek AI
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# AI analysis
AI_DAILY_BUDGET=50
AI_MAX_TOPICS_PER_RUN=50
AI_ANALYSIS_INTERVAL=300000

# Scrapers
SCRAPER_ENABLED=true
SCRAPER_INTERVAL_BAIDU=300000
SCRAPER_INTERVAL_WEIBO=300000
SCRAPER_INTERVAL_DOUYIN=600000
SCRAPER_INTERVAL_GITHUB=3600000
SCRAPER_INTERVAL_HACKERNEWS=900000
SCRAPER_INTERVAL_PRODUCTHUNT=3600000
SCRAPER_INTERVAL_TWITTER=900000
SCRAPER_INTERVAL_REDDIT=1800000
SCRAPER_INTERVAL_BINGNEWS=1800000

# Proxy for Reddit / Google News (optional)
# HTTPS_PROXY=http://127.0.0.1:7892

# WebSocket
WS_CORS_ORIGIN=http://localhost:5173
WS_PING_TIMEOUT=60000
WS_PING_INTERVAL=25000

# Notifications
NOTIFICATION_MIN_SCORE=70
NOTIFICATION_QUIET_START=23:00
NOTIFICATION_QUIET_END=08:00

LOG_LEVEL=debug
